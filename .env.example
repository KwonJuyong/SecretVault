# Copy to .env and fill in. The backend refuses to start if SECRET_KEY is missing
# or left at a placeholder value.

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-this
POSTGRES_DB=cloudvault
DATABASE_URL=postgresql://vault:change-this@db:5432/cloudvault

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated exact origins. "*" is rejected: the API sends credentials, and
# browsers refuse a wildcard origin on credentialed requests.
CORS_ORIGINS=http://localhost:3000
